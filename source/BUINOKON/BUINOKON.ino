// =====================================================================
//  Constants
// =====================================================================
#define FPS            25
#define NGIRD          4          // girders 0 (bottom) .. 3 (the gorilla's)
#define LEDGE          4          // level index of Luna's ledge
#define MAXB           8          // max simultaneous barrels
#define MAXF           2          // max simultaneous fireballs

#define WALK_SPD       11         // 1/8 px per frame
#define HAM_SPD        8
#define CLIMB_SPD      5
#define JUMP_V         15         // initial upward velocity (1/8 px/frame)
#define GRAVITY        2

#define MARIO_W        5
#define MARIO_H        6
#define START_X        14
#define LUNA_X         33
#define BONUS_START    3500       // time bonus; -100 per second; 0 = Mario dies
#define HAMMER_FRAMES  230        // ~9 s of actual swinging

#define EE_MAGIC       0xD4

enum { S_TITLE, S_HELP, S_READY, S_PLAY, S_DYING, S_WIN, S_PAUSE, S_OVER };
enum { M_WALK, M_JUMP, M_CLIMB };
enum { B_OFF, B_ROLL, B_FALL, B_LADDER };
enum { F_OFF, F_WALK, F_UP, F_DOWN };

// ---- level geometry (PROGMEM) -------------------------------------------
const uint8_t GBASE[NGIRD] PROGMEM = { 44, 34, 24, 14 };

// Ladders: {gap g (joins level g and g+1), centre x}
#define NLAD 7
const uint8_t LADDERS[NLAD][2] PROGMEM = {
  {0, 66}, {0, 24},
  {1, 14}, {1, 54},
  {2, 70}, {2, 30},
  {3, 46}                      // up to Luna
};
// Broken ladders (decoration only): {gap, centre x}
const uint8_t BROKEN[3][2] PROGMEM = { {0, 44}, {1, 34}, {2, 52} };

// Hammers: {girder level, x}
const uint8_t HAMMERS[2][2] PROGMEM = { {1, 70}, {2, 7} };

const uint8_t HOP[14] PROGMEM = { 0,1,3,4,5,6,6,6,6,5,4,3,1,0 };

// =====================================================================
//  State
// =====================================================================
struct Mario {
  int16_t x8, y8, vy;
  int8_t  vx;
  uint8_t lev, mode, left, anim, lad;
  uint8_t ham;       // hammer energy left (0 = none carried)
  uint8_t combo;
  uint8_t sw;        // swinging this frame
};
struct Barrel { int16_t x8; int8_t y; uint8_t lev, st, lad, scored, wild; };
struct Fire   { int16_t x8; int8_t y; uint8_t lev, st, lad, t; int8_t dir; };

Mario  m;
Barrel bar[MAXB];
Fire   fire[MAXF];

uint8_t  state, timer, lives, lvl, spawnT, throwT, newHi, extraLife, pauseDelay;
uint8_t  bonusT, hamTaken, timeUp;
uint16_t score, hiScore, bonus, winBonus;

// =====================================================================
//  Geometry helpers
// =====================================================================
static int8_t surf(uint8_t k, int8_t x) {
  if (k >= LEDGE) return 6;
  if (x < 0) x = 0; else if (x > 83) x = 83;
  uint8_t t = (uint16_t)x * 4 / 84;                       // 0..3 : slope steps at x=21,42,63
  return (int8_t)pgm_read_byte(&GBASE[k]) + ((k & 1) ? t : 3 - t);
}
static int8_t xmin(uint8_t k) { return (k == LEDGE) ? 32 : ((k & 1) || k == 0) ? 0 : 6; }
static int8_t xmax(uint8_t k) { return (k == LEDGE) ? 52 : ((k & 1) ? 77 : 83); }
static int8_t rollDir(uint8_t k) { return (k & 1) ? 1 : -1; }
static uint8_t ladG(uint8_t i) { return pgm_read_byte(&LADDERS[i][0]); }
static uint8_t ladX(uint8_t i) { return pgm_read_byte(&LADDERS[i][1]); }
static int8_t marioCx() { return (m.x8 >> 3) + 2; }

// =====================================================================
//  Utilities
// =====================================================================
static void sfx(uint8_t pitch, uint8_t dur) { gb.sound.playNote(pitch, dur, 0); }

static void addScore(uint16_t n) {
  uint32_t s = (uint32_t)score + n;
  score = (s > 65535UL) ? 65535 : (uint16_t)s;
  if (!extraLife && score >= 7000) { extraLife = 1; if (lives < 9) lives++; gb.sound.playOK(); }
}
static void loadHi() {
  hiScore = (EEPROM.read(0) == EE_MAGIC) ? (EEPROM.read(1) | ((uint16_t)EEPROM.read(2) << 8)) : 0;
}
static void saveHi() {
  EEPROM.write(0, EE_MAGIC); EEPROM.write(1, hiScore & 0xFF); EEPROM.write(2, hiScore >> 8);
}
static void drawNum(int8_t x, int8_t y, uint16_t v, uint8_t digits) {      // zero padded
  for (int8_t i = digits - 1; i >= 0; i--) { gb.display.drawChar(x + i * 4, y, '0' + (v % 10), 1); v /= 10; }
}
static void drawNumR(int8_t xr, int8_t y, uint16_t v) {                    // right aligned, no leading zeros
  uint8_t d = v >= 10000 ? 5 : v >= 1000 ? 4 : v >= 100 ? 3 : v >= 10 ? 2 : 1;
  drawNum(xr - d * 4 + 1, y, v, d);
}
static void text(int8_t x, int8_t y, const __FlashStringHelper* s) {
  gb.display.cursorX = x; gb.display.cursorY = y; gb.display.print(s);
}
static void textC(int8_t y, const __FlashStringHelper* s) {
  text((LCDWIDTH - strlen_P((const char*)s) * 4 + 1) / 2, y, s);
}
static void clearRect(int8_t x, int8_t y, int8_t w, int8_t h) {
  gb.display.setColor(WHITE); gb.display.fillRect(x, y, w, h); gb.display.setColor(BLACK);
}
static void box(int8_t x, int8_t y, int8_t w, int8_t h) { clearRect(x, y, w, h); gb.display.drawRect(x, y, w, h); }
static bool ov(int8_t ax, int8_t ay, int8_t aw, int8_t ah, int8_t bx, int8_t by, int8_t bw, int8_t bh) {
  return ax < bx + bw && ax + aw > bx && ay < by + bh && ay + ah > by;
}

// =====================================================================
//  Game flow
// =====================================================================
static void startLife() {
  for (uint8_t i = 0; i < MAXB; i++) bar[i].st = B_OFF;
  for (uint8_t i = 0; i < MAXF; i++) fire[i].st = F_OFF;
  hamTaken = 0; m.ham = 0; m.sw = 0; m.combo = 0; bonusT = 0; timeUp = 0;
  m.lev = 0; m.mode = M_WALK; m.vy = 0; m.vx = 0; m.left = 0; m.anim = 0;
  m.x8 = START_X * 8; m.y8 = surf(0, START_X + 2) * 8;
  spawnT = 45; throwT = 0; bonus = BONUS_START;
  state = S_READY; timer = FPS * 2;
}
static void newGame() { score = 0; lives = 3; lvl = 1; newHi = 0; extraLife = 0; startLife(); }
static void gameOver() {
  newHi = 0;
  if (score > hiScore) { hiScore = score; saveHi(); newHi = 1; }
  state = S_OVER; timer = 0; sfx(4, 12);
}

// =====================================================================
//  Barrels and fireballs
// =====================================================================
static uint8_t barrelSpeed() { return 8 + (lvl < 5 ? lvl : 5); }
static uint8_t spawnGap()    { return (lvl < 4) ? 48 - 8 * lvl : 20; }

static void maybeSpawnFire() {                       // oil drum flares up
  uint8_t active = 0;
  for (uint8_t i = 0; i < MAXF; i++) if (fire[i].st) active++;
  if (active >= ((lvl < 2) ? 1 : MAXF)) return;
  uint8_t chance = 35 + 10 * lvl; if (chance > 90) chance = 90;
  if (random(100) >= chance) return;
  for (uint8_t i = 0; i < MAXF; i++) if (fire[i].st == F_OFF) {
    fire[i].st = F_WALK; fire[i].lev = 0; fire[i].x8 = 9 * 8; fire[i].dir = 1;
    fire[i].lad = 0; fire[i].t = 20; fire[i].y = surf(0, 11) - 6;
    sfx(2, 4); return;
  }
}

static void spawnBarrel() {
  for (uint8_t i = 0; i < MAXB; i++) if (bar[i].st == B_OFF) {
    bar[i].st = B_ROLL; bar[i].lev = NGIRD - 1; bar[i].lad = 0; bar[i].scored = 0;
    bar[i].wild = (random(100) < 15 + 5 * lvl);
    bar[i].x8 = 28 * 8; bar[i].y = surf(NGIRD - 1, 30) - 5;
    return;
  }
}

static void updateBarrels() {
  uint8_t spd0 = barrelSpeed();
  for (uint8_t i = 0; i < MAXB; i++) {
    Barrel &b = bar[i];
    if (b.st == B_OFF) continue;
    uint8_t spd = b.wild ? spd0 + spd0 / 2 : spd0;
    int8_t cx = (b.x8 >> 3) + 2;

    if (b.st == B_ROLL) {
      b.x8 += rollDir(b.lev) * spd; cx = (b.x8 >> 3) + 2;
      b.y = surf(b.lev, cx) - 5;
      if (b.lev == 0 && cx <= 4) { b.st = B_OFF; maybeSpawnFire(); continue; }      // into the oil drum
      if (b.lev > 0) {
        if ((rollDir(b.lev) > 0 && cx > xmax(b.lev)) || (rollDir(b.lev) < 0 && cx < xmin(b.lev))) { b.st = B_FALL; continue; }
        for (uint8_t k = 0; k < NLAD; k++) {                                          // sometimes take a ladder down
          if (ladG(k) + 1 != b.lev) continue;
          int8_t d = cx - (int8_t)ladX(k);
          if (d >= -1 && d <= 1 && b.lad != k + 1) {
            b.lad = k + 1;
            uint8_t chance = 25 + 8 * lvl; if (chance > 60) chance = 60;
            if (b.wild) chance = 100;
            if (random(100) < chance) { b.st = B_LADDER; b.x8 = ((int16_t)ladX(k) - 2) * 8; }
          }
        }
      }
    } else if (b.st == B_FALL) {
      b.y += 2; b.x8 += rollDir(b.lev) * 3; cx = (b.x8 >> 3) + 2;
      int8_t s = surf(b.lev - 1, cx);
      if (b.y + 5 >= s) {
        b.lev--; b.y = s - 5; b.st = B_ROLL; b.lad = 0;
        if (b.lev == 0 && cx <= 4) { b.st = B_OFF; maybeSpawnFire(); }
      }
    } else {                                                                          // B_LADDER
      b.y += 1;
      int8_t s = surf(b.lev - 1, cx);
      if (b.y + 5 >= s) { b.lev--; b.y = s - 5; b.st = B_ROLL; b.lad = 0; }
    }
  }
}

static void updateFires() {
  uint8_t spd = 5 + (lvl > 6 ? 3 : lvl / 2);
  for (uint8_t i = 0; i < MAXF; i++) {
    Fire &f = fire[i];
    if (f.st == F_OFF) continue;
    int8_t cx = (f.x8 >> 3) + 2;
    if (f.st == F_WALK) {
      f.x8 += f.dir * spd; cx = (f.x8 >> 3) + 2;
      if (cx < xmin(f.lev) + 2 || cx > xmax(f.lev) - 2) { f.dir = -f.dir; f.x8 += f.dir * spd * 2; cx = (f.x8 >> 3) + 2; }
      f.y = surf(f.lev, cx) - 6;
      if (f.t) f.t--;
      else {
        f.t = 25 + random(40);
        int8_t toward = (marioCx() > cx) ? 1 : -1;
        f.dir = (random(100) < 70) ? toward : -toward;
      }
      if (f.lad) { int8_t d = cx - (int8_t)ladX(f.lad - 1); if (d > 3 || d < -3) f.lad = 0; }
      for (uint8_t k = 0; k < NLAD; k++) {
        if (ladG(k) == NGIRD - 1) continue;                  // never up to Luna's ledge
        int8_t d = cx - (int8_t)ladX(k);
        if (d < -1 || d > 1 || f.lad == k + 1) continue;
        f.lad = k + 1;
        if (ladG(k) == f.lev && m.lev > f.lev && random(100) < 65)            { f.st = F_UP;   f.x8 = ((int16_t)ladX(k) - 2) * 8; }
        else if (ladG(k) + 1 == f.lev && m.lev < f.lev && random(100) < 45)   { f.st = F_DOWN; f.x8 = ((int16_t)ladX(k) - 2) * 8; }
      }
    } else if (gb.frameCount & 1) {                           // climbing at half speed
      if (f.st == F_UP) {
        f.y--;
        if (f.y + 6 <= surf(f.lev + 1, cx)) { f.lev++; f.y = surf(f.lev, cx) - 6; f.st = F_WALK; }
      } else {
        f.y++;
        if (f.y + 6 >= surf(f.lev - 1, cx)) { f.lev--; f.y = surf(f.lev, cx) - 6; f.st = F_WALK; }
      }
    }
  }
}

// =====================================================================
//  Mario
// =====================================================================
static int8_t findLadder(uint8_t gap, int8_t cx) {
  for (uint8_t k = 0; k < NLAD; k++)
    if (ladG(k) == gap) { int8_t d = cx - (int8_t)ladX(k); if (d >= -2 && d <= 2) return k; }
  return -1;
}
static void clampMario() {
  int16_t lo = (int16_t)xmin(m.lev) * 8, hi = ((int16_t)xmax(m.lev) - (MARIO_W - 1)) * 8;
  if (m.x8 < lo) m.x8 = lo;
  if (m.x8 > hi) m.x8 = hi;
}

static void updateMario() {
  bool L = gb.buttons.repeat(BTN_LEFT, 1), R = gb.buttons.repeat(BTN_RIGHT, 1);
  bool U = gb.buttons.repeat(BTN_UP, 1),   D = gb.buttons.repeat(BTN_DOWN, 1);
  bool B = gb.buttons.repeat(BTN_B, 1);
  int8_t dx = (R ? 1 : 0) - (L ? 1 : 0);

  if (m.mode == M_WALK) {
    m.sw = (B && m.ham) ? 1 : 0;                        // B: hammer out
    m.vx = dx;
    if (dx) { m.x8 += dx * (m.sw ? HAM_SPD : WALK_SPD); m.left = (dx < 0); clampMario(); m.anim++; }
    m.y8 = surf(m.lev, marioCx()) * 8;
    if (m.sw) {
      /* swinging: no jumping, no ladders */
    } else if (gb.buttons.pressed(BTN_A)) {             // A: jump
      m.mode = M_JUMP; m.vy = -JUMP_V; m.vx = dx; m.combo = 0; sfx(24, 3);
    } else if (U || D) {
      int8_t k = -1;
      if (U) k = findLadder(m.lev, marioCx());
      else if (m.lev > 0) k = findLadder(m.lev - 1, marioCx());
      if (k >= 0) {
        m.mode = M_CLIMB; m.lad = k; m.anim = 0;
        m.x8 = ((int16_t)ladX(k) - 2) * 8; m.lev = ladG(k);
        int8_t cx = ladX(k);
        m.y8 = (U ? surf(m.lev, cx) : surf(m.lev + 1, cx)) * 8;
      }
    }
  } else if (m.mode == M_JUMP) {
    m.sw = 0;
    m.x8 += m.vx * WALK_SPD; clampMario();
    m.y8 += m.vy; m.vy += GRAVITY;
    int16_t floorY = (int16_t)surf(m.lev, marioCx()) * 8;
    if (m.vy > 0 && m.y8 >= floorY) { m.y8 = floorY; m.mode = M_WALK; m.combo = 0; sfx(8, 1); }
  } else {                                              // M_CLIMB
    m.sw = 0;
    int8_t dy = (D ? 1 : 0) - (U ? 1 : 0);
    if (dy) {
      int8_t cx = ladX(m.lad);
      m.y8 += dy * CLIMB_SPD; m.anim++;
      int16_t top = (int16_t)surf(m.lev + 1, cx) * 8, bot = (int16_t)surf(m.lev, cx) * 8;
      if (m.y8 <= top) { m.y8 = top; m.lev++; m.mode = M_WALK; }
      else if (m.y8 >= bot) { m.y8 = bot; m.mode = M_WALK; }
      if ((m.anim & 3) == 0) sfx(14 + ((m.anim >> 2) & 1) * 2, 1);
    }
  }
}

static bool hitHazard() {
  int8_t footY = m.y8 >> 3;
  int8_t mx = (m.x8 >> 3) + 1, my = footY - 5;                       // 3x5 hit-box
  for (uint8_t i = 0; i < MAXB; i++)
    if (bar[i].st != B_OFF && ov(mx, my, 3, 5, (bar[i].x8 >> 3) + 1, bar[i].y, 3, 5)) return true;
  for (uint8_t i = 0; i < MAXF; i++)
    if (fire[i].st != F_OFF && ov(mx, my, 3, 5, (fire[i].x8 >> 3) + 1, fire[i].y, 3, 6)) return true;
  return false;
}

static void scoreJumps() {
  if (m.mode != M_JUMP) return;
  int8_t footY = m.y8 >> 3, cx = marioCx();
  for (uint8_t i = 0; i < MAXB; i++) {
    Barrel &b = bar[i];
    if (b.st != B_ROLL || b.scored || b.lev != m.lev) continue;
    int8_t d = cx - ((b.x8 >> 3) + 2);
    if (d >= -3 && d <= 3 && footY <= b.y) {                  // feet above the barrel's top
      b.scored = 1;
      addScore(m.combo == 0 ? 100 : (m.combo == 1 ? 300 : 800));
      if (m.combo < 2) m.combo++;
      sfx(30 + m.combo, 2);
    }
  }
}

static void hammerLogic() {
  if (m.mode == M_WALK && !m.ham) {                           // pick one up by walking over it
    for (uint8_t i = 0; i < 2; i++) {
      if ((hamTaken & (1 << i)) || m.lev != pgm_read_byte(&HAMMERS[i][0])) continue;
      int8_t d = marioCx() - ((int8_t)pgm_read_byte(&HAMMERS[i][1]) + 2);
      if (d >= -3 && d <= 3) { hamTaken |= 1 << i; m.ham = HAMMER_FRAMES; sfx(28, 5); }
    }
  }
  if (!m.sw || !m.ham) return;
  m.ham--;
  if ((m.ham & 7) == 0) sfx(5 + ((m.ham >> 3) & 1) * 3, 1);
  int8_t x0 = m.x8 >> 3, fy = m.y8 >> 3;
  int8_t zx = m.left ? x0 - 6 : x0, zy = fy - 7;              // 11 x 8 smash zone in front
  for (uint8_t i = 0; i < MAXB; i++)
    if (bar[i].st != B_OFF && ov(zx, zy, 11, 8, bar[i].x8 >> 3, bar[i].y, 5, 5)) { bar[i].st = B_OFF; addScore(300); sfx(34, 2); }
  for (uint8_t i = 0; i < MAXF; i++)
    if (fire[i].st != F_OFF && ov(zx, zy, 11, 8, fire[i].x8 >> 3, fire[i].y, 5, 6)) { fire[i].st = F_OFF; addScore(500); sfx(35, 3); }
}

// =====================================================================
//  Drawing
// =====================================================================
static void drawGirders() {
  for (uint8_t k = 0; k < NGIRD; k++) {
    int8_t a = xmin(k), z = xmax(k);
    for (uint8_t sgm = 0; sgm < 4; sgm++) {                    // 4 slope steps of 21 px
      int8_t x0 = sgm * 21, x1 = x0 + 20;
      if (x0 < a) x0 = a;
      if (x1 > z) x1 = z;
      if (x1 >= x0) gb.display.drawFastHLine(x0, surf(k, x0), x1 - x0 + 1);
    }
    if (k) for (int8_t x = a; x <= z; x += 2)                  // truss dots where there is room beneath
      if (surf(k - 1, x) - surf(k, x) >= 9) gb.display.drawPixel(x, surf(k, x) + 1);
  }
  gb.display.drawFastHLine(32, 6, 21);                         // Luna's ledge
  for (int8_t x = 32; x <= 52; x += 2) gb.display.drawPixel(x, 7);
}

static void drawLadders() {
  for (uint8_t k = 0; k < NLAD; k++) {
    int8_t cx = ladX(k), g = ladG(k);
    int8_t top = surf(g + 1, cx), bot = surf(g, cx);
    gb.display.drawFastVLine(cx - 2, top, bot - top);
    gb.display.drawFastVLine(cx + 2, top, bot - top);
    for (int8_t y = top + 1; y < bot; y += 2) gb.display.drawFastHLine(cx - 2, y, 5);
  }
  for (uint8_t k = 0; k < 3; k++) {                            // broken ladders: a stub at each end
    int8_t g = pgm_read_byte(&BROKEN[k][0]), cx = pgm_read_byte(&BROKEN[k][1]);
    int8_t top = surf(g + 1, cx), bot = surf(g, cx);
    gb.display.drawFastVLine(cx - 2, top, 4);  gb.display.drawFastVLine(cx + 2, top, 4);
    gb.display.drawFastHLine(cx - 2, top + 2, 5);
    gb.display.drawFastVLine(cx - 2, bot - 4, 4); gb.display.drawFastVLine(cx + 2, bot - 4, 4);
    gb.display.drawFastHLine(cx - 2, bot - 2, 5);
  }
}

static void drawMario(bool visible) {
  if (!visible) return;
  const uint8_t* s;
  if (m.mode == M_JUMP) s = spr_mario_jump;
  else if (m.mode == M_CLIMB) s = (m.anim & 4) ? spr_mario_climb1 : spr_mario_climb2;
  else { uint8_t a = m.vx ? (m.anim >> 1) % 3 : 0; s = (a == 0) ? spr_mario_stand : (a == 1) ? spr_mario_walk1 : spr_mario_walk2; }
  int8_t x = m.x8 >> 3, y = (m.y8 >> 3) - MARIO_H;
  if (m.left && m.mode != M_CLIMB) gb.display.drawBitmap(x, y, s, NOROT, FLIPH);
  else gb.display.drawBitmap(x, y, s);
  if (m.sw && (m.ham > 40 || (m.ham & 4))) {                  // hammer (blinks when nearly spent)
    if (gb.frameCount & 4) {
      if (m.left) gb.display.drawBitmap(x - 4, y + 2, spr_ham_dn, NOROT, FLIPH);
      else        gb.display.drawBitmap(x + 4, y + 2, spr_ham_dn);
    } else gb.display.drawBitmap(x + 1, y - 4, spr_ham_up);
  }
}

static void drawScene(bool marioVisible) {
  gb.display.setColor(BLACK);
  drawGirders();
  drawLadders();

  // oil drum + flame
  gb.display.drawBitmap(0, 39, spr_drum);
  if (gb.frameCount & 4) { gb.display.drawPixel(2, 37); gb.display.drawPixel(3, 36); gb.display.drawFastHLine(2, 38, 3); }
  else                   { gb.display.drawPixel(4, 37); gb.display.drawPixel(3, 36); gb.display.drawFastHLine(2, 38, 3); }

  // hammer pick-ups
  for (uint8_t i = 0; i < 2; i++) if (!(hamTaken & (1 << i))) {
    int8_t hx = pgm_read_byte(&HAMMERS[i][1]);
    gb.display.drawBitmap(hx, surf(pgm_read_byte(&HAMMERS[i][0]), hx + 2) - 5, spr_ham_item);
  }

  // 2x2 stack of upright barrels, and the gorilla
  gb.display.drawBitmap(0, 4, spr_barrel0); gb.display.drawBitmap(5, 4, spr_barrel0);
  gb.display.drawBitmap(0, 9, spr_barrel0); gb.display.drawBitmap(5, 9, spr_barrel0);
  const uint8_t* dk = spr_dk_idle;
  bool grab = (spawnT < 14 && state == S_PLAY);
  if (throwT) dk = spr_dk_throw;
  else if (grab || (gb.frameCount & 16)) dk = spr_dk_beat;
  gb.display.drawBitmap(11, 3 + ((state == S_READY && (gb.frameCount & 4)) ? 1 : 0), dk);
  if (grab && !throwT) gb.display.drawBitmap(27, 8, spr_barrel0);

  // Luna calls for help
  if (state != S_WIN && (gb.frameCount & 32)) text(40, 0, F("HELP!"));
  gb.display.drawBitmap(LUNA_X, 0, (gb.frameCount & 8) ? spr_luna0 : spr_luna1);

  // barrels, fireballs
  for (uint8_t i = 0; i < MAXB; i++) {
    if (bar[i].st == B_OFF) continue;
    uint8_t f = (gb.frameCount >> 2) & 3;
    if (rollDir(bar[i].lev) < 0) f = 3 - f;
    const uint8_t* s = (f == 0) ? spr_barrel0 : (f == 1) ? spr_barrel1 : (f == 2) ? spr_barrel2 : spr_barrel3;
    if (bar[i].wild) s = (f & 1) ? spr_barrelw0 : spr_barrelw1;
    gb.display.drawBitmap(bar[i].x8 >> 3, bar[i].y, s);
  }
  for (uint8_t i = 0; i < MAXF; i++)
    if (fire[i].st) gb.display.drawBitmap(fire[i].x8 >> 3, fire[i].y, (gb.frameCount & 2) ? spr_fire0 : spr_fire1);

  drawMario(marioVisible);

  // ---- HUD: lives (icons, top-left), hammer energy, score and bonus box (top-right)
  for (uint8_t i = 0; i < lives && i < 9; i++) gb.display.drawBitmap(i * 4, 0, spr_icon);
  if (m.ham) { gb.display.drawBitmap(28, 0, spr_ham_item); gb.display.drawFastHLine(28, 5, m.ham / 50 + 1); }
  drawNumR(83, 0, score);
  gb.display.drawRect(63, 5, 21, 7);
  if (bonus > 500 || (gb.frameCount & 4)) drawNum(66, 6, bonus, 4);
}

// =====================================================================
//  State handlers
// =====================================================================
static void doTitle() {
  gb.battery.show = true;
  gb.display.setFont(font5x7);
  text(15, 1, F("BUINOKONG"));
  text(16, 1, F("BUINOKONG"));
  gb.display.setFont(font3x5);

  gb.display.drawFastHLine(0, 30, 84);
  gb.display.drawBitmap(4, 13, spr_dk_big);
  uint8_t cyc = gb.frameCount % 64;
  gb.display.drawBitmap(26 + cyc, 25, (cyc & 4) ? spr_barrel0 : spr_barrel2);
  int8_t hop = (cyc >= 28 && cyc < 42) ? pgm_read_byte(&HOP[cyc - 28]) : 0;
  gb.display.drawBitmap(62, 24 - hop, hop ? spr_mario_jump : spr_mario_stand, NOROT, FLIPH);
  gb.display.drawBitmap(76, 24, (gb.frameCount & 16) ? spr_luna0 : spr_luna1);

  text(14, 33, F("HI-SCORE"));
  drawNum(48, 33, hiScore, 5);
  if ((gb.frameCount & 31) < 22) text(0, 41, F("A:PLAY B:KEYS C:EXIT"));

  if (gb.buttons.pressed(BTN_A)) { gb.sound.playOK(); gb.battery.show = false; newGame(); }
  else if (gb.buttons.pressed(BTN_B)) { gb.sound.playTick(); state = S_HELP; }
  else if (gb.buttons.pressed(BTN_C)) gb.changeGame();
}

static void doHelp() {
  gb.battery.show = false;
  text(0, 0,  F("= CONTROLS ="));
  text(0, 6,  F("LEFT/RIGHT: WALK"));
  text(0, 12, F("UP/DOWN: CLIMB"));
  text(0, 18, F("A: JUMP"));
  text(0, 24, F("B: HOLD FOR HAMMER"));
  text(0, 30, F("C: PAUSE"));
  text(0, 36, F("HOLD C+A: LOADER"));
  if ((gb.frameCount & 31) < 22) text(0, 42, F("SAVE LUNA!   A:BACK"));
  if (gb.buttons.pressed(BTN_A) || gb.buttons.pressed(BTN_B) || gb.buttons.pressed(BTN_C)) { gb.sound.playTick(); state = S_TITLE; }
}

static void doReady() {
  drawScene(true);
  box(18, 19, 48, 17);
  text(26, 22, F("LEVEL"));
  drawNum(52, 22, lvl, (lvl >= 10) ? 2 : 1);
  if (timer > FPS) textC(29, F("GET READY")); else textC(29, F("GO!"));
  if (--timer == 0) state = S_PLAY;
}

static void doPlay() {
  if (gb.buttons.pressed(BTN_C)) { state = S_PAUSE; pauseDelay = 6; sfx(20, 2); drawScene(true); return; }

  updateMario();
  updateBarrels();
  updateFires();
  hammerLogic();

  if (throwT) throwT--;
  if (spawnT) spawnT--;
  else {
    spawnBarrel(); throwT = 8; sfx(6, 2);
    spawnT = spawnGap() + random(20);
    if (lvl >= 2 && random(100) < 20) spawnT = 12;          // two in a row
  }

  scoreJumps();

  if (++bonusT >= FPS) {                                    // bonus: -100 per second, zero = time up
    bonusT = 0;
    if (bonus >= 100) bonus -= 100;
    if (bonus <= 500 && bonus) sfx(26, 1);
  }

  if (bonus == 0) { timeUp = 1; state = S_DYING; timer = 60; m.mode = M_WALK; m.sw = 0; drawScene(true); return; }
  if (!m.sw && hitHazard()) { state = S_DYING; timer = 60; m.mode = M_WALK; drawScene(true); return; }
  if (m.lev == LEDGE && m.mode == M_WALK && (m.x8 >> 3) <= LUNA_X + MARIO_W + 1) {      // reached Luna
    winBonus = bonus; addScore(1000 + bonus);
    state = S_WIN; timer = FPS * 3; drawScene(true); return;
  }
  drawScene(true);
}

static void doDying() {
  drawScene((timer & 4) == 0);
  if (timeUp) { box(18, 21, 48, 10); textC(24, F("TIME UP!")); }
  if (timer % 6 == 0) sfx(24 - (60 - timer) / 4, 3);
  if (--timer == 0) { if (lives > 0) lives--; if (lives == 0) gameOver(); else startLife(); }
}

static void doWin() {
  drawScene(true);
  gb.display.drawPixel(39, 1); gb.display.drawPixel(41, 1);                 // heart
  gb.display.drawFastHLine(38, 2, 5); gb.display.drawFastHLine(39, 3, 3); gb.display.drawPixel(40, 4);
  box(14, 19, 56, 22);
  textC(22, F("LUNA SAVED!"));
  text(20, 30, F("BONUS"));
  drawNum(42, 30, winBonus, 4);
  if (timer % 8 == 0) sfx(18 + ((FPS * 3 - timer) / 8 * 2) % 14, 3);
  if (--timer == 0) { lvl++; startLife(); }
}

static void doPause() {
  drawScene(true);
  box(5, 19, 74, 18);
  textC(22, F("PAUSED"));
  textC(29, F("C:RESUME B:QUIT"));
  if (pauseDelay) pauseDelay--;
  else {
    if (gb.buttons.pressed(BTN_C)) { state = S_PLAY; sfx(20, 2); }
    if (gb.buttons.pressed(BTN_B)) { state = S_TITLE; if (score > hiScore) { hiScore = score; saveHi(); } }
  }
}

static void doOver() {
  gb.display.fontSize = 2;
  text(6, 2, F("GAME"));
  text(6, 12, F("OVER"));
  gb.display.fontSize = 1;
  text(52, 3, F("SCORE")); drawNumR(83, 10, score);
  text(52, 18, F("BEST"));  drawNumR(83, 25, hiScore);
  if (newHi && (gb.frameCount & 8)) textC(32, F("NEW HIGH SCORE!"));
  if (timer < 255) timer++;
  if (timer > 40 && (gb.frameCount & 31) < 22) textC(41, F("A:AGAIN  B:MENU"));
  if (timer > 40) {
    if (gb.buttons.pressed(BTN_A)) { gb.sound.playOK(); newGame(); }
    else if (gb.buttons.pressed(BTN_B)) { gb.sound.playTick(); state = S_TITLE; }
  }
}

// =====================================================================
//  Arduino entry points
// =====================================================================
void setup() {
  gb.begin();
  gb.setFrameRate(FPS);
  gb.pickRandomSeed();
  gb.battery.show = true;
  loadHi();
  state = S_TITLE;
  for (uint8_t i = 0; i < MAXB; i++) bar[i].st = B_OFF;
  for (uint8_t i = 0; i < MAXF; i++) fire[i].st = F_OFF;
  lives = 3; lvl = 1; score = 0; spawnT = 255; throwT = 0;
}

void loop() {
  if (!gb.update()) return;
  switch (state) {
    case S_TITLE: doTitle(); break;
    case S_HELP:  doHelp();  break;
    case S_READY: doReady(); break;
    case S_PLAY:  doPlay();  break;
    case S_DYING: doDying(); break;
    case S_WIN:   doWin();   break;
    case S_PAUSE: doPause(); break;
    case S_OVER:  doOver();  break;
  }
}
